@"
# .env.example — copy to .env and fill in your values
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

OLLAMA_BASE_URL=http://host.docker.internal:11434

POSTGRES_URL=postgresql://postgres:your_password@postgres:5432/nexus_audit
POSTGRES_DB=nexus_audit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

REDIS_URL=redis://:your_password@redis:6379/0
REDIS_PASSWORD=your_password_here

ENVIRONMENT=development

API_KEYS=your-key-1:label_1,your-key-2:label_2
HEALTHCHECK_API_KEY=your-key-1
"@ | Out-File -Encoding utf8 .env.example